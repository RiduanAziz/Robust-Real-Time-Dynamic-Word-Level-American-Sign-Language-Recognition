# ==============================================================================
# SignFlow Application Environment Configuration Template
# Copy this file to .env and customize for local or production deployment.
# Never commit actual secret tokens or credentials to Git.
# ==============================================================================

# Server & Network Configuration
PORT=8000
PYTHONPATH=src
LOG_LEVEL=INFO

# Compute Hardware Device (cpu or cuda)
SIGNFLOW_DEVICE=cpu

# Model Architecture Selection:
# - ensemble_3way: Winning 3-Way Probability Ensemble (76.65% Top-1 / 91.44% Top-5)
# - robust_holistic_fusion: Baseline model
# - unisign_pgf: Uni-Sign Prior-Guided Fusion model
# - max_accuracy: Deep BiGRU model
SIGNFLOW_MODEL_SET=ensemble_3way

# Explicit Local Asset Paths (optional overrides; defaults to ./models)
# SIGNFLOW_MODEL_PATH=models/robust_holistic_fusion_best.pt
# SIGNFLOW_CONFIG_PATH=configs/dataset.yaml
# SIGNFLOW_MEDIAPIPE_ASSET_PATH=models/mediapipe/holistic_landmarker.task

# Cloud Deployment Asset Bootstrap (Used by Docker / Render cloud builds)
# SIGNFLOW_ASSET_BUNDLE_URL=https://github.com/USERNAME/REPO/releases/download/v1.0.0/signflow-inference-assets.zip
# SIGNFLOW_ASSET_BUNDLE_SHA256=243f58437898ce7ead899e3514006e636135d132789d97e63ff59cb4addc5b66
# SIGNFLOW_ASSET_TOKEN=

# CORS Security (Comma-separated allowed origins; leave empty for same-origin + local dev)
# SIGNFLOW_CORS_ORIGINS=https://your-service.onrender.com,http://localhost:5173

# Public Service Safeguards & Resource Limits
SIGNFLOW_MAX_CONNECTIONS=50
SIGNFLOW_MAX_FRAME_BYTES=2097152

# Pipeline & Experiment Variables (used for offline training / evaluation)
DATA_DIR=data
MODELS_DIR=models
RESULTS_DIR=results
SEED=42
